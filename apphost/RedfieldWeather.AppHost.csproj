<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.0" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>redfield-weather-local-apphost</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.0" />
    <PackageReference Include="Aspire.Hosting.Azure.Functions" Version="13.6.0" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../api/src/RedfieldWeather/RedfieldWeather.csproj" />
    <ProjectReference Include="../rw-app/RedfieldWeather.App.csproj" />
  </ItemGroup>
</Project>
